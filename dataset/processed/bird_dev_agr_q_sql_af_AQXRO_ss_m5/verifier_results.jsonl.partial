t      INTEGER   null,\n    Latitude    REAL      null,\n    Longitude   REAL      null,\n    AdmFName1   TEXT null,\n    AdmLName1   TEXT null,\n    AdmEmail1   TEXT null,\n    AdmFName2   TEXT null,\n    AdmLName2   TEXT null,\n    AdmEmail2   TEXT null,\n    AdmFName3   TEXT  null,\n    AdmLName3   TEXT null,\n    AdmEmail3   TEXT null,\n    LastUpdate  DATE        not null\n)", "db_id": "california_schools", "difficulty": "challenging", "clusters": [{"cluster_id": "2", "vote_count": 2, "representative_sql": "SELECT T1.School, T1.DOCType FROM schools AS T1 INNER JOIN frpm AS T2 ON T1.CDSCode = T2.CDSCode WHERE T1.FundingType = 'Local' ORDER BY T2.\"Enrollment (K-12)\" - T2.\"Enrollment (Ages 5-17)\" > (SELECT AVG(T2.\"Enrollment (K-12)\" - T2.\"Enrollment (Ages 5-17)\") FROM schools AS T1 INNER JOIN frpm AS T2 ON T1.CDSCode = T2.CDSCode WHERE T1.FundingType = 'Local')", "labels": {"output_semantics": "S", "constraint_semantics": "S", "ranking_semantics": "U", "relation_semantics": "S", "overall": "S"}, "reasons": {"output_semantics": "The SQL returns the requested school names and DOC type, and computes the difference between K-12 enrollment and 15-17 enrollment, then filters for differences above the average difference of locally funded schools.", "constraint_semantics": "The SQL correctly joins the `schools` and `frpm` tables on `CDSCode`, filters for locally funded schools (`FundingType = 'Local'`), and computes the required difference. The average is computed correctly using a subquery.", "ranking_semantics": "The task does not require ranking, ordering, or limiting, so this is not applicable.", "relation_semantics": "The SQL correctly joins the `schools` and `frpm` tables on `CDSCode`, and uses the `FundingType` filter appropriately.", "overall": "The SQL satisfies the task by correctly computing the required difference, filtering for locally funded schools, and returning the requested school names and DOC type."}, "reason": "The SQL satisfies the task by correctly computing the required difference, filtering for locally funded schools, and returning the requested school names and DOC type.", "verification": {"status": "ok", "cache_key": "80b4f64a9d384771c6f68050a59a7ba591e5513739becb978f02d29a743d3c20", "attempts": 1, "prompt_version": "qrank-svem-semantic-v1", "backend": "transformers", "model": "Qwen/Qwen3-1.7B"}, "metadata": {"candidate_indices": [2, 3]}}], "collection_status": "ok"}
