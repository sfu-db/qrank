OM RankedSchools WHERE rank <= 5", "labels": {"output_semantics": "S", "constraint_semantics": "S", "ranking_semantics": "S", "relation_semantics": "S", "overall": "S"}, "reasons": {"output_semantics": "The SQL returns the requested `School` entity and calculates the average reading score using `AVG(ss.AvgScrRead)`, which is correct for the task.", "constraint_semantics": "The SQL correctly filters `Virtual = 'F'` and joins with `satscores` on `s.CDSCode = ss.cds`, using the correct column names and table references.", "ranking_semantics": "The SQL uses `ROW_NUMBER() OVER (ORDER BY AVG(ss.AvgScrRead) DESC NULLS FIRST)` to rank schools by their average reading scores, and selects the top 5 with `WHERE rank <= 5`.", "relation_semantics": "The SQL properly joins `schools` and `satscores` on `CDSCode`, and uses `Virtual = 'F'` to filter exclusively virtual schools.", "overall": "The SQL satisfies the task by returning the top 5 highest average reading scores from exclusively virtual schools, with correct filtering, aggregation, and ranking."}, "reason": "The SQL satisfies the task by returning the top 5 highest average reading scores from exclusively virtual schools, with correct filtering, aggregation, and ranking.", "verification": {"status": "ok", "cache_key": "5fd110ecf4aa0e7c3daebfad09ea45cccb0278e5532f9c573b7db5ffa8467147", "attempts": 1, "prompt_version": "qrank-svem-semantic-v1", "backend": "transformers", "model": "Qwen/Qwen3-1.7B"}, "metadata": {"candidate_indices": [4]}}], "collection_status": "ok"}
{"question_id": "42", "question": "What is the type of education offered in the school who scored the highest average in Math?", "evidence": "", "schema": "CREATE TABLE frpm\n(\n    CDSCode                                       TEXT not null\n        primary key,\n    `Academic Year`                               TEXT  null,\n    `County Code`                                 TEXT  null,\n    `District Code`                               INTEGER         null,\n    `School Code`                                 TEXT  null,\n    `County Name`                                 TEXT null,\n    `District Name`                               TEXT null,\n    `School Name`                                 TEXT null,\n    `District Type`                               TEXT null,\n    `School Type`                                 TEXT null,\n    `Educational Option Type`                     TEXT null,\n    `NSLP Provision Status`                       TEXT null,\n    `Charter School (Y/N)`                        INTEGER    null,\n    `Charter School Number`                       TEXT  null,\n    `Charter Funding Type`                        TEXT null,\n    IRC                                           INTEGER    null,\n    `Low Grade`                                   TEXT  null,\n    `High Grade`                                  TEXT null,\n    `Enrollment (K-12)`                           REAL      null,\n    `Free Meal Count (K-12)`                      REAL       null,\n    `Percent (%) Eligible Free (K-12)`            REAL       null,\n    `FRPM Count (K-12)`                           REAL       null,\n    `Percent (%) Eligible FRPM (K-12)`            REAL       null,\n    `Enrollment (Ages 5-17)`                      REAL       null,\n    `Free Meal Count (Ages 5-17)`                 REAL       null,\n    `Percent (%) Eligible Free (Ages 5-17)`       REAL       null,\n    `FRPM Count (Ages 5-17)`                      REAL       null,\n    `Percent (%) Eligible FRPM (Ages 5-17)